{
  "name": "ib-tws-node",
  "version": "2.1.3",
  "description": "Node client library for for Interactive Broker's Trading Workstation and Gateway",
  "type": "module",
  "main": "src/ib-tws-node.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "./postinstall.js",
    "test": "node --test --test-timeout=1200000 test/*.test.js",
    "inspect": "node --inspect-brk --test --experimental-test-isolation=none test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catch-point/ib-tws-node.git"
  },
  "keywords": [
    "ib",
    "tws",
    "twsapi",
    "interactive",
    "brokers",
    "gateway",
    "trading",
    "finance",
    "automated",
    "library"
  ],
  "author": "James Leigh",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/catch-point/ib-tws-node/issues"
  },
  "homepage": "https://github.com/catch-point/ib-tws-node#readme",
  "bin": {
    "ib-tws-json": "./src/ib-tws-json.js"
  },
  "binary-dependencies": {
    "lib/ib-tws-json.jar": {
      "url": "https://github.com/catch-point/ib-tws-json/releases/download/v2.1.1/ib-tws-json-2.1.1.jar",
      "sha256": "121d8618ae31284607fab7a6dcee433017ab6944fda6d94e4646973776418399"
    }
  }
}
